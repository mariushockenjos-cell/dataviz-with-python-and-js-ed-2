import matplotlib.pyplot as plt
import pandas as pd

# Alle Farb-Labels (vollständig)
color_labels = {
    'n': 'brown',
    'b': 'buff',
    'g': 'gray',
    'r': 'green',
    'p': 'pink',
    'u': 'purple',
    'e': 'red',
    'w': 'white',
    'y': 'yellow',
    'l': 'blue',
    'o': 'orange',
    'k': 'black'
}

# Fehlende Werte in den Farbspalten als 'unknown' markieren
df['cap-color_x'] = df['cap-color_x'].fillna('unknown')
df['veil-color_x'] = df['veil-color_x'].fillna('unknown')

# Figure mit zwei Subplots
fig, axes = plt.subplots(1, 2, figsize=(20, 6))

# ============================================================================ 
# CAP-COLOR
# ============================================================================
ct_cap = pd.crosstab(df['cap-color_x'], df['class'])
ct_cap.plot(kind='bar', stacked=False, color=['green', 'red'], ax=axes[0])
axes[0].set_xlabel('cap-color')
axes[0].set_ylabel('Anzahl')
axes[0].set_title('Anzahl essbar (e) vs giftig (p) nach cap-color')
axes[0].tick_params(axis='x', rotation=45)
axes[0].legend().remove()  # Entferne automatische Legende

# ============================================================================ 
# VEIL-COLOR
# ============================================================================
ct_veil = pd.crosstab(df['veil-color_x'], df['class'])
ct_veil.plot(kind='bar', stacked=False, color=['green', 'red'], ax=axes[1])
axes[1].set_xlabel('veil-color')
axes[1].set_ylabel('Anzahl')
axes[1].set_title('Anzahl essbar (e) vs giftig (p) nach veil-color')
axes[1].tick_params(axis='x', rotation=45)
axes[1].legend().remove()  # Entferne automatische Legende

# ============================================================================ 
# GEMEINSAME LEGENDE (rechts außen)
# ============================================================================
# Farben für Class
colors = {"e": "green", "p": "red"}

# Class Legend (oben rechts außerhalb)
class_legend = [
    plt.Line2D([0], [0], color=colors["e"], lw=5, label="e = essbar"),
    plt.Line2D([0], [0], color=colors["p"], lw=5, label="p = giftig")
]
legend1 = axes[1].legend(handles=class_legend, title="Class", 
                         bbox_to_anchor=(1.05, 1), loc="upper left")

# Color-Codes Legend (mittig rechts außerhalb)
color_legend = [
    plt.Line2D([0], [0], color="black", lw=0, marker='o', markersize=8,
               label=f"{k} = {v}") for k, v in color_labels.items()
]
legend2 = axes[1].legend(handles=color_legend, title="Color-Codes",
                         bbox_to_anchor=(1.05, 0.5), loc="center left", frameon=True)
axes[1].add_artist(legend1)

plt.tight_layout()
plt.show()
